# Copy to .env and adjust. docker compose reads this file automatically.

POSTGRES_PASSWORD=change-me

# Used by services inside compose (host "db"). For local dev outside Docker,
# point at localhost instead:
#   DATABASE_URL=postgresql://episteme:change-me@localhost:5432/episteme

# --- LLM gateway: any OpenAI-compatible endpoint ---
# Defaults target llama-server (router mode) on the host, port 5001.
# Model names must match what /v1/models reports.
# LLM_BASE_URL=http://host.docker.internal:5001/v1
# Each role may have its own server; unset = served from LLM_BASE_URL. Which
# roles share an endpoint is pure config — no role is special-cased in code.
# Out of the box only the embedder is split out (always-resident, CPU-only, so
# the router's --models-max 1 can't evict it); set LLM_EMBED_BASE_URL= (empty)
# to serve embeddings from the router too.
# LLM_MAIN_BASE_URL=
# LLM_FAST_BASE_URL=
# LLM_EMBED_BASE_URL=http://host.docker.internal:5002/v1
# LLM_MODEL_MAIN=Qwopus3.6-35B-A3B-Coder-MTP-Q4_K_M
# LLM_MODEL_FAST=empero-ai_Qwythos-9B-Claude-Mythos-5-1M-GGUF_Qwythos-9B-Claude-Mythos-5-1M-MTP-Q4_K_M
# LLM_MODEL_EMBED=Octen-Embedding-4B.Q8_0   # or Octen-Embedding-0.6B.f16 (faster)
# PIPELINE_CRON=0 3 * * *     # nightly pipeline run (embed -> cluster -> triage -> write)
# MAX_WRITES_PER_RUN=10

# --- llama-warden (the GPU warden on the host) ---
# Episteme is in Docker, llama.cpp is on the Windows host: a container cannot
# start a host process or read its console. llama-warden is that crossing, an
# optional loopback service on the host: llama.cpp start/stop/restart, its log
# tail, and GPU measurements, all surfaced in /admin. It also decides when the
# GPU is contended and pushes that verdict to /api/pipeline/announce (0057), so
# there is no threshold to set here any more; it lives in the warden's own
# warden.toml.
#   On the host:  C:\selfhosting\llama-warden, see its README
# LEAVING THIS UNSET DISABLES THE WHOLE FEATURE and Episteme behaves exactly as
# it did before the warden existed: no backend panel, and nothing ever pauses it
# for a game. It is optional infrastructure, not a dependency.
# LLM_WARDEN_URL=http://host.docker.internal:5003
# LLM_LOG_TAIL_LINES=300
# LLM_GRACEFUL_STOP_SECONDS=120   # how long a stop waits for the current work unit
# Three timeouts, because a read and an action want opposite things. Reads sit on
# the dashboard's critical path (status on page load, logs every 3s) so they must
# fail fast; actions block until the host is done (start = launcher + port wait,
# restart = a stop and a start in one request) and a ceiling shorter than the work
# renders a success as a failure.
# LLM_WARDEN_READ_TIMEOUT_SECONDS=15
# LLM_WARDEN_TIMEOUT_SECONDS=240
# LLM_WARDEN_RESTART_TIMEOUT_SECONDS=360

# --- Backups (worker runs pg_dump -Fc --compress=zstd; manual-only in alpha:
#     POST /api/jobs/defer/backup_database) ---
# BACKUP_DIR points at the HOST directory the dumps land in (compose bind-mount);
# defaults to ./backups. Everything else is optional (see config.py defaults).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14    # <=0 keeps every dump
# BACKUP_ZSTD_LEVEL=12        # pg_dump --compress=zstd:<level> (1..22)
# BACKUP_ENABLED=true

# --- TTS narration (Fish Audio; streamed opus) ---
# The post page streams narration on demand (opus over Fish's WebSocket), playing
# as it synthesizes and caching the result under AUDIO_DIR (host bind-mount,
# served at /media). Voices are a DB catalog (the `voices` table, seeded by
# seeds.seed_voices); the reader picks one per post and each is cached. Nightly
# batch narration of the default voice runs only when TTS_ENABLED=true; you can
# also defer it manually with POST /api/jobs/defer/narrate?post_id=N.
# FISH_API_KEY=your-fish-audio-api-key
# TTS_ENABLED=false                    # true = narrate runs nightly after qa (default voice)
# TTS_DEFAULT_VOICE=                   # override the catalog default voice id; empty = David Attenborough
# TTS_MODEL=s2.1-pro-free              # Fish `model` header; -free = free tier (s2.1-pro needs paid credits)
# TTS_OPUS_BITRATE=64000               # streamed opus bitrate in bps (24000|32000|48000|64000)
# AUDIO_DIR=./media                    # HOST dir the audio lands in (compose bind-mount)

# --- Notifications (ntfy, 0056) ---
# Empty NTFY_BASE_URL is the off switch: nothing is sent and nothing raises.
# The topics are separate so lunch can be muted without muting the digest.
# PUBLIC_BASE_URL is how the PHONE reaches this app; it is deliberately not
# WEB_INTERNAL_URL (http://web:8200), which resolves only inside the docker
# network and would send every notification's tap to a dead host. Unset means
# the notifications carry no link at all.
# NTFY_BASE_URL=https://ntfy.your-tailnet.ts.net
# NTFY_TOKEN=tk_...                    # sent as Authorization: Bearer
# NTFY_TOPIC_DIGEST=episteme
# NTFY_TOPIC_LUNCH=episteme-lunch
# PUBLIC_BASE_URL=https://episteme.your-tailnet.ts.net
# DIGEST_CRON=0 6 * * *                # 06:00 UTC = 08:00 local in summer
# DIGEST_STALE_HOURS=20                # older than this and the digest says so
# MATSEDEL_NOTIFY_CRON=0 9 * * 1-5     # 09:00 UTC = 11:00 local in summer
