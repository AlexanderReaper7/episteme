# Copy to .env and adjust. docker compose reads this file automatically.

POSTGRES_PASSWORD=change-me

# Used by services inside compose (host "db"). For local dev outside Docker,
# point at localhost instead:
#   DATABASE_URL=postgresql://episteme:change-me@localhost:5432/episteme

# --- LLM gateway: any OpenAI-compatible endpoint ---
# Defaults target llama-server (router mode) on the host, port 5001.
# Model names must match what /v1/models reports.
# LLM_BASE_URL=http://host.docker.internal:5001/v1
# LLM_MODEL_WRITER=Qwopus3.6-35B-A3B-Coder-MTP-Q4_K_M
# LLM_MODEL_FAST=empero-ai_Qwythos-9B-Claude-Mythos-5-1M-GGUF_Qwythos-9B-Claude-Mythos-5-1M-MTP-Q4_K_M
# LLM_MODEL_EMBED=            # required for the pipeline; needs a GGUF embedding model
# PIPELINE_CRON=0 3 * * *     # nightly pipeline run (embed -> cluster -> triage -> write)
# MAX_WRITES_PER_RUN=10
