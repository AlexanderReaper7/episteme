# Copy to .env and adjust. docker compose reads this file automatically.

POSTGRES_PASSWORD=change-me

# Used by services inside compose (host "db"). For local dev outside Docker,
# point at localhost instead:
#   DATABASE_URL=postgresql://episteme:change-me@localhost:5432/episteme

# --- LLM gateway: any OpenAI-compatible endpoint ---
# Defaults target llama-server (router mode) on the host, port 5001.
# Model names must match what /v1/models reports.
# LLM_BASE_URL=http://host.docker.internal:5001/v1
# LLM_MODEL_MAIN=Qwopus3.6-35B-A3B-Coder-MTP-Q4_K_M
# LLM_MODEL_FAST=empero-ai_Qwythos-9B-Claude-Mythos-5-1M-GGUF_Qwythos-9B-Claude-Mythos-5-1M-MTP-Q4_K_M
# LLM_MODEL_EMBED=Octen-Embedding-4B.Q8_0   # or Octen-Embedding-0.6B.f16 (faster)
# PIPELINE_CRON=0 3 * * *     # nightly pipeline run (embed -> cluster -> triage -> write)
# MAX_WRITES_PER_RUN=10

# --- Backups (worker runs pg_dump -Fc --compress=zstd; manual-only in alpha:
#     POST /api/jobs/defer/backup_database) ---
# BACKUP_DIR points at the HOST directory the dumps land in (compose bind-mount);
# defaults to ./backups. Everything else is optional (see config.py defaults).
# BACKUP_DIR=./backups
# BACKUP_RETENTION_DAYS=14    # <=0 keeps every dump
# BACKUP_ZSTD_LEVEL=12        # pg_dump --compress=zstd:<level> (1..22)
# BACKUP_ENABLED=true

# --- TTS narration (Fish Audio; streamed opus) ---
# The post page streams narration on demand (opus over Fish's WebSocket), playing
# as it synthesizes and caching the result under AUDIO_DIR (host bind-mount,
# served at /media). Voices are a DB catalog (the `voices` table, seeded by
# seeds.seed_voices); the reader picks one per post and each is cached. Nightly
# batch narration of the default voice runs only when TTS_ENABLED=true; you can
# also defer it manually with POST /api/jobs/defer/narrate?post_id=N.
# FISH_API_KEY=your-fish-audio-api-key
# TTS_ENABLED=false                    # true = narrate runs nightly after qa (default voice)
# TTS_DEFAULT_VOICE=                   # override the catalog default voice id; empty = David Attenborough
# TTS_MODEL=s2.1-pro-free              # Fish `model` header; -free = free tier (s2.1-pro needs paid credits)
# TTS_OPUS_BITRATE=64000               # streamed opus bitrate in bps (24000|32000|48000|64000)
# AUDIO_DIR=./media                    # HOST dir the audio lands in (compose bind-mount)
